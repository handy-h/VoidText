# 小说文本清洗工具 - 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# 基础配置
# ============================================

# 服务端口 (默认: 8080)
PORT=8080

# 数据目录路径 (默认: ./data)
# 数据库文件(cleaning.db)、上传文件、备份文件均存储在此目录
DATA_DIR=./data

# 模型目录路径 (默认: ./models)
MODELS_DIR=./models

# 最大文件上传大小 (字节, 默认: 104857600 = 100MB)
MAX_FILE_SIZE=104857600

# 备份文件保留天数 (默认: 7)
BACKUP_KEEP_DAYS=7

# ============================================
# 文件名解析配置
# ============================================

# 文件名分隔符列表（用|分隔，按优先级排序）
# 用于从文件名中提取作者和标题
# 示例: "作者 - 标题.txt" → 作者="作者", 标题="标题"
# 示例: "作者_标题.txt"   → 作者="作者", 标题="标题"
NAME_SEPARATORS=-|—|·|·|_| 

# ============================================
# 第一阶段：基础文本清洗配置
# ============================================

# 是否启用基础文本清洗 (默认: true)
ENABLE_BASIC_CLEANING=true

# 基础清洗工具 (默认: regex)
BASIC_CLEANING_TOOL=regex

# 是否启用繁体转简体 (默认: false)
TRADITIONAL_TO_SIMPLE=false

# ============================================
# 第二阶段：向量检测配置
# ============================================

# 是否启用向量检测去重 (默认: true)
ENABLE_VECTOR_DETECTION=true

# 向量模型名称 (默认: all-MiniLM-L6-v2)
VECTOR_MODEL_NAME=all-MiniLM-L6-v2

# 向量模型类型 (默认: local)
# local: 使用本地简化向量计算
# api:   调用外部API生成向量
VECTOR_MODEL_TYPE=local

# 向量相似度阈值 (默认: 0.95, 范围: 0.0~1.0)
VECTOR_SIMILARITY_THRESHOLD=0.95

# 向量模型API地址 (当VECTOR_MODEL_TYPE=api时生效)
# 示例: https://dashscope.aliyuncs.com/compatible-mode/v1
VECTOR_MODEL_URL=

# 向量模型API密钥
VECTOR_MODEL_API_KEY=

# ============================================
# 第三阶段：LLM修复配置
# ============================================

# 是否启用模型修复 (默认: true)
ENABLE_MODEL_REPAIR=true

# 修复模型名称 (默认: gpt-3.5-turbo-instruct)
REPAIR_MODEL_NAME=gpt-3.5-turbo-instruct

# 修复模型类型 (默认: api)
# api:   调用外部LLM进行文本修复
# local: 使用本地错别字字典进行修复
REPAIR_MODEL_TYPE=api

# LLM API地址
# 示例: https://api.openai.com/v1
# 示例: https://dashscope.aliyuncs.com/compatible-mode/v1 (阿里云)
# 示例: https://api.deepseek.com/v1 (DeepSeek)
# 示例: http://localhost:11434/v1 (Ollama本地)
LLM_API_URL=

# LLM API密钥
# Ollama本地可使用任意值如"ollama"
LLM_API_KEY=

# 文本生成模型名称 (默认: gpt-3.5-turbo-instruct)
# 阿里云示例: qwen-max-2025-01-25
# DeepSeek示例: deepseek-chat
# Ollama示例: qwen2.5:3b
COMPLETION_MODEL_NAME=gpt-3.5-turbo-instruct

# 生成温度 (默认: 0.3, 范围: 0.0~2.0)
COMPLETION_TEMPERATURE=0.3

# 最大生成token数 (默认: 2048)
COMPLETION_MAX_TOKENS=2048

# 是否启用LLM智能段落重组 (默认: false)
# 启用后会在错别字修复前先用AI识别语义段落边界，
# 合并被硬换行切断的行，在正确位置插入段落分隔。
# 需要配合本地或远程LLM使用，建议使用 qwen2.5:3b 或以上模型
ENABLE_LLM_PARAGRAPH_RECONSTRUCT=false

# 段落重组分块大小（字符数，默认: 8000）
# 长文本会按此大小分块后逐块处理，块间有200字符重叠保证连贯性
PARAGRAPH_CHUNK_SIZE=8000

# 是否启用LLM智能段落重组 (默认: false)
# 启用后会在LLM错别字修复前，先用AI识别语义段落边界，
# 合并被硬切断的行（如固定宽度排版），在正确位置插入段落换行。
# 适用于以下场景：
# - 老电子书导出的固定宽度硬换行文本
# - OCR识别后缺少段落结构的文本
# - 网页复制后换行混乱的文本
ENABLE_LLM_PARAGRAPH_RECONSTRUCT=false

# 段落重组分块大小（字符数，默认: 8000）
# 长文本会按此大小分块后逐块发送到LLM处理，块之间有重叠以保证连贯性
PARAGRAPH_CHUNK_SIZE=8000

# ============================================
# 兼容旧配置（自动映射到新配置）
# ============================================

# 以下旧配置仍然支持，会自动映射到对应的新配置
# 但建议使用上面的新配置项
# EXTERNAL_API_URL=     → 映射到 VECTOR_MODEL_URL 和 LLM_API_URL
# EXTERNAL_API_KEY=     → 映射到 VECTOR_MODEL_API_KEY 和 LLM_API_KEY
# EMBEDDING_MODEL_NAME= → 映射到 COMPLETION_MODEL_NAME
