# ============================================================
# 湮文 VoidText - 环境变量配置模板
# 使用说明：复制此文件为 .env，并根据实际情况修改配置
# ============================================================


# ========================
# 1. 系统基础配置
# ========================

# [选填] 服务端口
PORT=8080

# [选填] 项目根目录 (用于定位 scripts、config 等资源文件)
BASE_DIR=.

# [选填] 数据存储目录 (数据库、上传文件、备份均存储于此)
DATA_DIR=./data

# [选填] 模型存储目录
MODELS_DIR=./models

# [选填] 最大文件上传大小 (单位: 字节, 默认100MB)
MAX_FILE_SIZE=104857600

# [选填] 备份文件保留天数
BACKUP_KEEP_DAYS=7


# ========================
# 3. 文件名解析配置
# ========================

# [选填] 文件名分隔符 (用 | 分隔，按优先级排序)
# 用途：从文件名中提取作者和标题
# 示例："作者 - 标题.txt" 或 "作者_标题.txt"
NAME_SEPARATORS=-|—|·|·|_|


# ========================
# 4. 处理流水线：第一阶段 (基础清洗)
# ========================

# [选填] 是否启用基础文本清洗
ENABLE_BASIC_CLEANING=true

# [选填] 基础清洗工具 (目前仅支持 regex)
BASIC_CLEANING_TOOL=regex

# [选填] 是否启用繁体转简体
TRADITIONAL_TO_SIMPLE=false


# ========================
# 5. 处理流水线：第二阶段 (向量检测去重)
# ========================

# [选填] 是否启用向量检测去重
ENABLE_VECTOR_DETECTION=true

# [选填] 向量模型类型 (local: 本地简化计算 | api: 外部API生成)
VECTOR_MODEL_TYPE=local

# [选填] 向量模型名称 (local 模式下的模型名)
VECTOR_MODEL_NAME=all-MiniLM-L6-v2

# [选填] 向量相似度阈值 (范围 0.0~1.0, 越高要求越严格)
VECTOR_SIMILARITY_THRESHOLD=0.95

# [条件必填] 向量模型 API 地址 (VECTOR_MODEL_TYPE=api 时必填)
# 示例: https://dashscope.aliyuncs.com/compatible-mode/v1
VECTOR_MODEL_URL=

# [条件必填] 向量模型 API 密钥 (VECTOR_MODEL_TYPE=api 时必填)
VECTOR_MODEL_API_KEY=


# ========================
# 6. 处理流水线：第三阶段 (LLM 修复与增强)
# ========================

# [选填] 是否启用 LLM 文本修复
ENABLE_MODEL_REPAIR=true

# [选填] 修复模型类型 (api: 远程大模型 | local: 本地错别字字典)
REPAIR_MODEL_TYPE=api

# --- 远程大模型配置 (REPAIR_MODEL_TYPE=api 时生效) ---

# [条件必填] LLM API 地址
# 示例: OpenAI(https://api.openai.com/v1) | 阿里云(https://dashscope.aliyuncs.com/compatible-mode/v1) | DeepSeek(https://api.deepseek.com/v1)
LLM_API_URL=

# [条件必填] LLM API 密钥
LLM_API_KEY=

# [选填] 文本生成模型名称 (默认: gpt-3.5-turbo-instruct | 阿里云: qwen-max-2025-01-25 | DeepSeek: deepseek-chat)
COMPLETION_MODEL_NAME=gpt-3.5-turbo-instruct

# [选填] 修复指令模型名称 (通常与文本生成模型一致)
REPAIR_MODEL_NAME=gpt-3.5-turbo-instruct

# [选填] 生成温度 (范围 0.0~2.0, 越低越确定，越高越发散)
COMPLETION_TEMPERATURE=0.3

# [选填] 单次生成最大 Token 数
COMPLETION_MAX_TOKENS=2048


# --- 本地模型配置 (混合架构，作为远程 API 的降级/备用方案) ---

# [选填] 是否启用本地模型 (启用后优先走本地，失败或置信度低时降级到远程)
ENABLE_LOCAL_MODEL=false

# [选填] 本地模型 API 地址 (Ollama 默认地址)
LOCAL_MODEL_URL=http://localhost:11434

# [选填] 本地模型名称 (推荐使用量化版以节省显存，如 qwen2.5:7b-instruct-q4_K_M)
# 自定义校正模型: voidtext-repair (用 `ollama create voidtext-repair -f Modelfile` 创建，
# 可确保 System Prompt 通过 ChatML 模板正确传递，专为文本校对优化)
LOCAL_MODEL_NAME=voidtext-repair

# [选填] 本地模型请求超时时间 (单位: 秒, 默认180)
# 流式模式下此超时为整个推理过程的总超时，建议不低于120秒
LOCAL_MODEL_TIMEOUT=180

# [选填] 本地模型置信度阈值 (范围 0.0~1.0, 低于此值将降级到远程 API)
LOCAL_CONFIDENCE_THRESHOLD=0.3

# [选填] 是否允许本地失败时降级到远程 API
LOCAL_FALLBACK_ENABLED=true


# --- 自进化监控 ---

# [选填] 是否启用自进化监控 (开启后当 API 错误率高或缓存命中率低时，自动优化提示词)
ENABLE_EVOLVER=false


# ========================
# 7. 兼容旧版配置 (自动映射)
# ========================
# 以下旧配置仍支持，系统会自动映射到新配置项，建议尽快迁移至新配置：
# EXTERNAL_API_URL     → 映射到 VECTOR_MODEL_URL 和 LLM_API_URL
# EXTERNAL_API_KEY     → 映射到 VECTOR_MODEL_API_KEY 和 LLM_API_KEY
# EMBEDDING_MODEL_NAME → 映射到 COMPLETION_MODEL_NAME