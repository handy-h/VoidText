# 小说文本清洗工具 - 环境变量配置模板
#
# 使用方法: 复制此文件为 .env 并根据实际环境修改配置
#
# 清洗管线分为三个阶段:
#   第一阶段 - 基础文本清洗: 正则清理、繁简转换
#   第二阶段 - 向量检测去重: 识别并移除重复段落
#   第三阶段 - 文本修复: 错别字修复（API / 本地字典 / 本地 Ollama）
#
# 每个阶段可通过对应的 ENABLE_* 变量独立开关

# ============================================
# 基础配置
# ============================================

# 服务端口（默认: 8080）
PORT=8080

# 数据目录路径（默认: ./data）
# 数据库(cleaning.db)、上传文件、备份文件均存储于此
DATA_DIR=./data

# 模型目录路径（默认: ./models）
MODELS_DIR=./models

# 最大文件上传大小（字节, 默认: 104857600 = 100MB）
MAX_FILE_SIZE=104857600

# 备份文件保留天数（默认: 7）
BACKUP_KEEP_DAYS=7

# ============================================
# 文件名解析配置
# ============================================

# 文件名分隔符列表（用 | 分隔，按优先级排序）
# 用于从文件名提取作者和标题
# 示例: "作者 - 标题.txt" → 作者="作者", 标题="标题"
NAME_SEPARATORS=-|—|·|·|_|

# ============================================
# 第一阶段：基础文本清洗
# ============================================

# 是否启用基础文本清洗（默认: true）
ENABLE_BASIC_CLEANING=true

# 基础清洗工具（默认: regex）
BASIC_CLEANING_TOOL=regex

# 是否启用繁体转简体（默认: false）
TRADITIONAL_TO_SIMPLE=false

# ============================================
# 第二阶段：向量检测去重
# ============================================

# 是否启用向量检测去重（默认: true）
ENABLE_VECTOR_DETECTION=true

# 向量嵌入模型名称（默认: all-MiniLM-L6-v2）
# 当 VECTOR_MODEL_TYPE=ollama 时，填写本地 Ollama 中的嵌入模型名称
# Ollama 嵌入模型示例: nomic-embed-text:latest, bge-m3:latest
# ⚠ 切勿使用嵌入模型作为下方 COMPLETION_MODEL_NAME，否则 chat API 会返回 404
VECTOR_MODEL_NAME=nomic-embed-text:latest

# 向量模型类型（默认: local）
#   local:   本地简化向量计算（7 维特征，不调用外部模型）
#   api:     调用外部 OpenAI 兼容 API 生成向量
#   ollama:  调用本地 Ollama 嵌入模型（复用下方 LOCAL_MODEL_URL，无需单独填 URL/Key）
VECTOR_MODEL_TYPE=ollama

# 向量相似度阈值（默认: 0.95, 范围: 0.0~1.0）
# 高于此阈值判定为重复段落；值越高去重越保守
VECTOR_SIMILARITY_THRESHOLD=0.95

# 向量模型 API 地址（VECTOR_MODEL_TYPE=api 时生效）
VECTOR_MODEL_URL=

# 向量模型 API 密钥（VECTOR_MODEL_TYPE=api 时生效）
VECTOR_MODEL_API_KEY=

# ============================================
# 本地 Ollama 通用配置
# ============================================
# 以下配置同时影响第二阶段（向量嵌入）和第三阶段（文本修复）
#
# 向量嵌入: VECTOR_MODEL_TYPE=ollama 时，调用 ${LOCAL_MODEL_URL}/api/embed
# 文本修复: ENABLE_LOCAL_MODEL=true  时，调用 ${LOCAL_MODEL_URL}/v1/chat/completions

# Ollama API 地址（默认: http://localhost:11434）
LOCAL_MODEL_URL=http://localhost:11434

# 请求超时时间（秒, 默认: 30）
# CPU 推理或首次加载模型时建议调高至 120~180
LOCAL_MODEL_TIMEOUT=180

# ============================================
# 第三阶段：文本修复
# ============================================

# 是否启用模型修复（默认: true）
# 关闭后将跳过整个修复阶段
ENABLE_MODEL_REPAIR=true

# --- 子方式 A: 外部 API 修复 ---

# 修复模型类型（默认: api）
# 注意优先级: 本地 Ollama(ENABLE_LOCAL_MODEL) > API(type=api) > 内置字典(type=local)
#   api:   调用外部 LLM API 进行修复（需配置下方 LLM_API_URL 等）
#   local: 使用内置错别字字典修复（无需网络，修改量有限）
#
# 如需使用本地 Ollama 模型修复，请配置 ENABLE_LOCAL_MODEL=true，
# 此时无论 REPAIR_MODEL_TYPE 设为何值，Ollama 都会优先执行。
REPAIR_MODEL_TYPE=api

# LLM API 地址
# 示例: https://api.openai.com/v1
# 示例: https://dashscope.aliyuncs.com/compatible-mode/v1（阿里云 DashScope，推荐）
# 示例: https://api.deepseek.com/v1（DeepSeek）
# 示例: http://localhost:11434/v1（Ollama 兼容模式，需带 /v1 后缀）
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM API 密钥
# Ollama 本地兼容模式可使用任意值如 "ollama"；远程 API 请填入真实密钥
LLM_API_KEY=

# 文本生成模型名称（默认: gpt-3.5-turbo-instruct）
# ⚠ 必须是 chat/completions 模型，不能是 embedding 模型
# 支持逗号分隔最多 5 个模型名，按顺序尝试：第一个限额用完后自动切换到下一个
# 切换条件：429 限流、余额不足、额度耗尽等不可恢复错误
# 5 个模型都失败后，自动切换到备用服务商（LLM_API_URL_2 / LLM_API_URL_3）
#
# 阿里云示例: qwen-plus-2025-01-25, qwen-max-2025-01-25, qwen-turbo-2025-01-25
# DeepSeek 示例: deepseek-chat
# Ollama 示例: qwen2.5:3b, modelscope.cn/Qwen/Qwen2.5-3B-Instruct-GGUF:latest
# 多模型示例: qwen-plus-2025-01-25,qwen-max-2025-01-25,qwen-turbo-2025-01-25
COMPLETION_MODEL_NAME=qwen-plus-2025-01-25

# --- 备用服务商（可选）---
# 当第一服务商的所有模型均失败后，自动切换到备用服务商（最多2个）。
# 切换条件：连接超时、拒绝、DNS 解析失败、5xx 服务端错误、429 限流、额度耗尽等。

# 备用服务商2 API 地址（默认: 空，不启用）
# LLM_API_URL_2=https://api.deepseek.com/v1

# 备用服务商2 API 密钥
# LLM_API_KEY_2=

# 备用服务商2 模型名称
# COMPLETION_MODEL_NAME_2=deepseek-chat

# 备用服务商3 API 地址（默认: 空，不启用）
# LLM_API_URL_3=

# 备用服务商3 API 密钥
# LLM_API_KEY_3=

# 备用服务商3 模型名称
# COMPLETION_MODEL_NAME_3=

# 生成温度（默认: 0.3, 范围: 0.0~2.0）
# 值越低输出越确定，越高越有创造性
COMPLETION_TEMPERATURE=0.3

# 最大生成 token 数（默认: 2048）
COMPLETION_MAX_TOKENS=2048

# --- 子方式 B: 本地 Ollama 模型修复 ---
# 使用本地运行的大模型进行修复，与 REPAIR_MODEL_TYPE 独立

# 是否启用本地 LLM 文本修复（默认: false）
ENABLE_LOCAL_MODEL=false

# 本地 LLM 模型名称（用于文本修复生成）
# 注意：向量嵌入模型名称在上方 VECTOR_MODEL_NAME 配置，两者不要混用
# Ollama 对话模型示例: qwen2.5:7b-instruct-q4_K_M, modelscope.cn/Qwen/Qwen2.5-3B-Instruct-GGUF:latest
LOCAL_MODEL_NAME=modelscope.cn/Qwen/Qwen2.5-3B-Instruct-GGUF:latest

# --- 预处理步骤: LLM 智能段落重组 ---
# 在错别字修复前，先用 AI 识别语义段落边界，合并被硬换行切断的行。
# 适用场景: 固定宽度排版文本、OCR 缺少段落结构、网页复制换行混乱

# 是否启用 LLM 智能段落重组（默认: true）
# 需要配合远程或本地 LLM 使用，建议至少 qwen2.5:3b 或以上
# 如果未配置 LLM API，段落重组步骤会自动跳过，不影响后续处理
ENABLE_LLM_PARAGRAPH_RECONSTRUCT=true

# 段落重组分块大小（字符数, 默认: 8000）
# 长文本按此大小分块后逐块处理，块间 200 字符重叠保证连贯性
PARAGRAPH_CHUNK_SIZE=8000

# ============================================
# 兼容旧配置（自动映射到新配置）
# ============================================
#
# 以下旧配置项仍支持自动映射，推荐优先使用上方新配置项:
#
#   EXTERNAL_API_URL=     → VECTOR_MODEL_URL + LLM_API_URL
#   EXTERNAL_API_KEY=     → VECTOR_MODEL_API_KEY + LLM_API_KEY
#   EMBEDDING_MODEL_NAME= → COMPLETION_MODEL_NAME
