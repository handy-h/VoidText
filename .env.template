# 小说文本清洗工具 - 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# 基础配置
# ============================================

# 服务端口 (默认: 8080)
PORT=8080

# 数据目录路径 (默认: ./data)
DATA_DIR=./data

# 模型目录路径 (默认: ./models)
MODELS_DIR=./models

# 最大文件上传大小 (字节, 默认: 104857600 = 100MB)
MAX_FILE_SIZE=104857600

# 备份文件保留天数 (默认: 7)
BACKUP_KEEP_DAYS=7

# ============================================
# 第一阶段：基础文本清洗配置
# ============================================

# 是否启用基础文本清洗 (默认: true)
ENABLE_BASIC_CLEANING=true

# 基础清洗工具 (默认: regex)
# 可选值: regex (当前仅支持正则表达式方式)
BASIC_CLEANING_TOOL=regex

# 是否启用繁体转简体 (默认: false)
TRADITIONAL_TO_SIMPLE=false

# ============================================
# 第二阶段：向量检测配置
# ============================================

# 是否启用向量检测去重 (默认: true)
ENABLE_VECTOR_DETECTION=true

# 向量模型名称 (默认: all-MiniLM-L6-v2)
# 本地模式: all-MiniLM-L6-v2, paraphrase-MiniLM-L6-v2
# API模式: text-embedding-ada-002, text-embedding-v3 等
VECTOR_MODEL_NAME=all-MiniLM-L6-v2

# 向量模型类型 (默认: local)
# local: 使用本地简化向量计算（无需额外依赖）
# api:   调用外部API生成向量
VECTOR_MODEL_TYPE=local

# 向量相似度阈值 (默认: 0.95)
# 超过此阈值的段落将被判定为重复内容
# 取值范围: 0.0 ~ 1.0，值越高判定越严格
VECTOR_SIMILARITY_THRESHOLD=0.95

# ============================================
# 第三阶段：模型修复配置
# ============================================

# 是否启用模型修复 (默认: true)
ENABLE_MODEL_REPAIR=true

# 修复模型名称 (默认: gpt-3.5-turbo-instruct)
# 示例: gpt-4, qwen-max-2025-01-25, deepseek-chat 等
REPAIR_MODEL_NAME=gpt-3.5-turbo-instruct

# 修复模型类型 (默认: api)
# api:   调用外部API进行文本修复
# local: 使用本地错别字字典进行修复
REPAIR_MODEL_TYPE=api

# ============================================
# 外部API配置
# ============================================

# OpenAI兼容API的基础URL
# 示例: https://api.openai.com/v1
# 示例: https://dashscope.aliyuncs.com/compatible-mode/v1 (阿里云)
EXTERNAL_API_URL=

# API密钥
# 示例: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXTERNAL_API_KEY=

# ============================================
# 模型名称配置
# ============================================

# 嵌入模型名称 (用于文本向量化，当VECTOR_MODEL_TYPE=api时生效)
# 默认值: text-embedding-ada-002
# 示例: text-embedding-3-small, text-embedding-3-large, text-embedding-v3
EMBEDDING_MODEL_NAME=text-embedding-ada-002

# 文本生成模型名称 (用于文本纠正和摘要生成)
# 默认值: gpt-3.5-turbo-instruct
# 示例: gpt-4, qwen-max-2025-01-25, deepseek-chat
COMPLETION_MODEL_NAME=gpt-3.5-turbo-instruct

# ============================================
# 文本生成模型调用参数
# ============================================

# 生成温度 (默认: 0.3)
# 控制输出的随机性，值越低输出越稳定确定
# 取值范围: 0.0 ~ 2.0
# 推荐值: 0.1~0.5 (校对纠错场景建议较低温度)
COMPLETION_TEMPERATURE=0.3

# 最大生成token数 (默认: 2048)
# 限制模型单次输出的最大长度
# 建议根据待处理段落长度调整
COMPLETION_MAX_TOKENS=2048

# ============================================
# 配置说明
# ============================================

# 1. 外部API配置是可选的，如果不配置，项目将仅使用本地NLP功能
# 2. 模型名称需要与您的API提供商支持的模型名称一致
# 3. 支持以下API提供商：
#    - OpenAI官方API:           https://api.openai.com/v1
#    - 阿里云DashScope:         https://dashscope.aliyuncs.com/compatible-mode/v1
#    - DeepSeek:                https://api.deepseek.com/v1
#    - 其他兼容OpenAI API的第三方服务
# 4. 三阶段处理流程可独立启用/禁用，灵活组合
# 5. 配置示例（阿里云DashScope + qwen模型）：
#    EXTERNAL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    EXTERNAL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#    EMBEDDING_MODEL_NAME=text-embedding-v3
#    COMPLETION_MODEL_NAME=qwen-max-2025-01-25
#    COMPLETION_TEMPERATURE=0.3
#    COMPLETION_MAX_TOKENS=2048