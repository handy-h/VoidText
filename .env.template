# VoidText - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改
#
# 每个阶段可通过对应的 ENABLE_* 变量独立开关

# ============================================
# 基础配置（必选）
# ============================================

# 服务端口（默认: 8080）
PORT=8080

# 数据目录（默认: ./data）
# 数据库、上传文件、备份均存放于此
DATA_DIR=./data

# 最大上传大小（字节，默认: 104857600 = 100MB）
MAX_FILE_SIZE=104857600

# 备份保留天数（默认: 7）
BACKUP_KEEP_DAYS=7

# ============================================
# 文件名解析（可选）
# ============================================

# 分隔符列表（按优先级），用于从文件名提取作者和标题
# 示例: "作者 - 标题.txt" -> 作者="作者", 标题="标题"
NAME_SEPARATORS=-|—|·|_|~

# ============================================
# 第一阶段：基础清洗（可选）
# ============================================

ENABLE_BASIC_CLEANING=true
BASIC_CLEANING_TOOL=regex
TRADITIONAL_TO_SIMPLE=false

# ============================================
# 第二阶段：向量去重（可选）
# ============================================

ENABLE_VECTOR_DETECTION=true

# 向量模型类型
#   local  - 本地简化向量（7 维特征，无外部依赖）
#   api    - 调用外部 OpenAI 兼容 API
#   ollama - 调用本地 Ollama 嵌入模型
VECTOR_MODEL_TYPE=ollama

# 嵌入模型名称（VECTOR_MODEL_TYPE=ollama 时必填）
# 示例: nomic-embed-text:latest, bge-m3:latest
VECTOR_MODEL_NAME=nomic-embed-text:latest

# 相似度阈值（默认: 0.95，范围 0.0~1.0）
# 值越高去重越保守
VECTOR_SIMILARITY_THRESHOLD=0.95

# 外部向量 API（VECTOR_MODEL_TYPE=api 时必填）
VECTOR_MODEL_URL=
VECTOR_MODEL_API_KEY=

# ============================================
# 本地 Ollama 通用配置（可选）
# ============================================
# 以下配置同时影响第二阶段（向量嵌入）和第三阶段（文本修复）

LOCAL_MODEL_URL=http://localhost:11434

# 请求超时（秒，默认: 30）
# CPU 推理或首次加载模型时建议调高至 120~180
LOCAL_MODEL_TIMEOUT=180

# ============================================
# 第三阶段：文本修复（至少配置一种方式）
# ============================================

ENABLE_MODEL_REPAIR=true

# --- 方式 A：外部 API 修复 ---

# 修复类型
#   api   - 调用外部 LLM API（需配置下方 URL/Key）
#   local - 使用内置错别字字典（无需网络，修改量有限）
# 注意：ENABLE_LOCAL_MODEL=true 时，本地 Ollama 始终优先，不受此值影响
REPAIR_MODEL_TYPE=api

# 主服务商
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# 对话模型名称（必须是 chat/completions 模型，不能是 embedding 模型）
# 支持逗号分隔最多 5 个模型名，按顺序尝试
COMPLETION_MODEL_NAME=qwen-plus-2025-01-25

# --- 备用服务商（可选，最多 2 个） ---
# 主服务商所有模型失败后自动切换

# LLM_API_URL_2=https://api.deepseek.com/v1
# LLM_API_KEY_2=
# COMPLETION_MODEL_NAME_2=deepseek-chat

# LLM_API_URL_3=
# LLM_API_KEY_3=
# COMPLETION_MODEL_NAME_3=

# 生成参数
COMPLETION_TEMPERATURE=0.3
COMPLETION_MAX_TOKENS=2048
LLM_MAX_OUTPUT_TOKENS=4096

# --- 方式 B：本地 Ollama 修复 ---

ENABLE_LOCAL_MODEL=false
LOCAL_MODEL_NAME=modelscope.cn/Qwen/Qwen2.5-3B-Instruct-GGUF:latest

# --- LLM 智能段落重组（可选） ---
# 在修复前先用 AI 识别语义段落边界，合并被硬换行切断的行
# 适用：固定宽度排版、OCR 文本、网页复制内容

ENABLE_LLM_PARAGRAPH_RECONSTRUCT=true
PARAGRAPH_CHUNK_SIZE=8000

# 换行修复：最小段落长度（字符数，默认: 80）
# 低于此值的短段落会与后续段落合并，避免过度碎片化
# 对话密集型小说可设为 40~60 以获得更细粒度的分段
# 设为 0 可禁用合并（每个语义段落保持独立）
MIN_PARAGRAPH_LENGTH=80

# ============================================
# 限流配置（可选）
# ============================================

# 是否启用限流（默认: true）
# 设为 false 可完全禁用限流（开发环境推荐）
# RATE_LIMIT_ENABLED=true

# 全局限流：每分钟最大请求数（默认: 100）
# RATE_LIMIT_GLOBAL_MAX_REQUESTS=100

# 全局限流：时间窗口（秒，默认: 60）
# RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# 全局限流：清理间隔（秒，默认: 300）
# RATE_LIMIT_GLOBAL_CLEANUP_SECONDS=300

# 上传限流：每分钟最大请求数（默认: 10）
# RATE_LIMIT_UPLOAD_MAX_REQUESTS=10

# API限流：每分钟最大请求数（默认: 60）
# RATE_LIMIT_API_MAX_REQUESTS=60

# 严格限流：每分钟最大请求数（默认: 30）
# RATE_LIMIT_STRICT_MAX_REQUESTS=30

# 端点限流：每分钟最大请求数（默认: 50）
# RATE_LIMIT_ENDPOINT_MAX_REQUESTS=50

# ============================================
# 兼容旧配置（自动映射）
# ============================================
# 以下旧键仍被支持，推荐优先使用上方新键:
#   EXTERNAL_API_URL  -> VECTOR_MODEL_URL + LLM_API_URL
#   EXTERNAL_API_KEY  -> VECTOR_MODEL_API_KEY + LLM_API_KEY
#   EMBEDDING_MODEL_NAME -> COMPLETION_MODEL_NAME
